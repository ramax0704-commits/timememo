rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 사용자 메모
    match /users/{uid}/memos/{document=**} {
      allow read, write: if request.auth.uid == uid;
    }

    // 사용자 설정 (습관 키워드 등)
    match /users/{uid}/settings/{document=**} {
      allow read, write: if request.auth.uid == uid;
    }

    // 기타 사용자 정보
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
    }
  }
}
